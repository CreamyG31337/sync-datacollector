# Real per-site config with network paths / device names / project folders.
# Never commit this — copy config.example.json to config.json and edit locally.
config.json
config.json.bak*

# Runtime log
sync-log.txt

# Per-install record of what was last synced per profile (see "out of date" awareness).
sync-state.json
sync-state.json.bak*

# Windows / editor noise
Thumbs.db
Desktop.ini
*.tmp
.vs/

# Graphify local runtime files
graphify-out/cache/
graphify-out/cost.json
graphify-out/.graphify_*.json
graphify-out/.graphify_root

# Generated graph artifacts: derived output, and dated snapshots that pile up.
graphify-out/.graphify_*.json.sig
graphify-out/graph.html
graphify-out/20*/

# Graphify staleness marker, rewritten on every run.
graphify-out/needs_update

# Per-machine dev tooling: these carry absolute paths into one person's
# home directory and uv tool env, so they are useless to anyone else.
# Keep them locally; do not publish them.
.mcp.json
.vscode/tasks.json
